// Angel OS — Prisma schema
// PostgreSQL is the single structured source of truth (see docs/ARCHITECTURE.md).
// Every personal object is scoped to `principalId`. There is exactly one
// Principal row today (Angel); the FK shape stays ready for multi-user later
// without any multi-user logic being implemented now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Principal ────────────────────────────────────────────────────────────

model Principal {
  id        String   @id @default(uuid())
  name      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  people             Person[]
  projects           Project[]
  tasks              Task[]
  reminders          Reminder[]
  goals              Goal[]
  decisions          Decision[]
  memories           Memory[]
  permissions        Permission[]
  approvals          ApprovalRequest[]
  auditLogs          AuditLog[]
  connections        Connection[]
  oauthStates        OAuthState[]
  apiTokens          ApiToken[]
  externalIdentities ExternalIdentity[]
  activities         Activity[]
  memoryRevisions    MemoryRevision[]

  @@map("principals")
}

// ── Structured state ────────────────────────────────────────────────────

// People Angel knows — NOT employees, NOT agency staff.
model Person {
  id           String    @id @default(uuid())
  principalId  String
  principal    Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  name         String
  relationship String? // e.g. "friend", "sister", "colleague at X" — free text, not a role/org concept
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tasks Task[]

  @@index([principalId])
  @@map("people")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Project {
  id          String        @id @default(uuid())
  principalId String
  principal   Principal     @relation(fields: [principalId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks     Task[]
  decisions Decision[]

  @@index([principalId])
  @@map("projects")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id              String     @id @default(uuid())
  principalId     String
  principal       Principal  @relation(fields: [principalId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  relatedPersonId String?
  relatedPerson   Person?    @relation(fields: [relatedPersonId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  dueAt           DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  reminders Reminder[]

  @@index([principalId])
  @@index([projectId])
  @@map("tasks")
}

enum ReminderStatus {
  PENDING // waiting for remindAt (or for a retry after a definite delivery failure)
  CLAIMED // a worker holds the lease and is delivering it
  SENT // delivered — the channel confirmed acceptance
  FAILED // gave up: non-retryable failure or attempts exhausted
  UNCONFIRMED // a send was attempted but its outcome is unknown; never re-sent automatically
  DISMISSED
}

model Reminder {
  id          String         @id @default(uuid())
  principalId String
  principal   Principal      @relation(fields: [principalId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  message     String
  remindAt    DateTime
  status      ReminderStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Delivery lifecycle (see docs/architecture/reminders-and-delivery.md).
  claimedAt         DateTime?
  leaseUntil        DateTime? // a CLAIMED row whose lease has passed is recoverable
  deliveryAttempts  Int       @default(0) // also the fence token for the current claim
  lastAttemptAt     DateTime?
  sendStartedAt     DateTime? // set immediately before the channel call: after this, a crash means "unknown"
  nextAttemptAt     DateTime? // backoff after a retryable failure
  deliveredAt       DateTime?
  deliveryChannel   String?
  lastDeliveryError String? // a short safe code, never provider text

  @@index([principalId])
  @@index([remindAt])
  @@index([status, remindAt])
  @@map("reminders")
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

enum GoalHorizon {
  SHORT
  MEDIUM
  LONG
}

model Goal {
  id          String      @id @default(uuid())
  principalId String
  principal   Principal   @relation(fields: [principalId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      GoalStatus  @default(ACTIVE)
  horizon     GoalHorizon @default(MEDIUM)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([principalId])
  @@map("goals")
}

// A Decision is CURRENT STATE that becomes HISTORY once superseded — it is
// never rewritten, only ever superseded by a new row referencing it, so
// "what did I decide about X" stays answerable from a stable log.
model Decision {
  id           String    @id @default(uuid())
  principalId  String
  principal    Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String
  context      String?
  decision     String
  supersedesId String?   @unique
  supersedes   Decision? @relation("DecisionHistory", fields: [supersedesId], references: [id])
  supersededBy Decision? @relation("DecisionHistory")
  decidedAt    DateTime  @default(now())

  @@index([principalId])
  @@map("decisions")
}

// ── Memory (distinct from structured state and knowledge) ─────────────────

enum MemoryType {
  FACT
  PREFERENCE
  PRINCIPLE
  DECISION
  GOAL
  HABIT
  EXPERIENCE
  PERSON
  PROJECT
  INFERENCE
  LESSON // what an experience taught (may reference the experience via derivedFromId)
  RELATIONSHIP // something about Angel's relationship with a person/group (subject names them)
  CONTEXT // situational personal context ("traveling until March"); pair with validUntil
}

// Where a memory came from. Invariants (enforced in the database, not just code):
//   type INFERENCE  <=>  provenance INFERRED   (a belief is never laundered into a fact by relabeling)
//   type EXPERIENCE  =>  provenance EXPERIENCED
enum ProvenanceKind {
  STATED // Angel said or entered it
  OBSERVED // the system observed it (not inferred beyond the observation)
  EXPERIENCED // personally experienced / tested
  INFERRED // a derived belief, hypothesis or conclusion
}

enum MemoryStatus {
  ACTIVE // confirmed / standing
  UNCONFIRMED // inferred, not yet promoted to a standing fact
  EXPIRED
  RETRACTED
}

model Memory {
  id              String       @id @default(uuid())
  principalId     String
  principal       Principal    @relation(fields: [principalId], references: [id], onDelete: Cascade)
  type            MemoryType
  content         String
  source          String // e.g. "conversation", "manual", "inference:task-pattern"
  confidence      Float        @default(1.0) // 0..1, lower for INFERENCE
  status          MemoryStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastConfirmedAt DateTime?
  // System lifetime: the memory stops being retrieved after this instant.
  expiresAt       DateTime?

  // ── Memory OS (Build #9) ──
  provenance      ProvenanceKind   @default(STATED)
  sourceRef       String? // free reference to the origin (a message id, a URL, a memory id) — provenance detail, never authority
  subject         String? // who/what it is about ("Ana", "my sister", "Bogotá trip")
  occurredAt      DateTime? // when the experience/event happened (world time)
  validFrom       DateTime? // world-time validity window: true from…
  validUntil      DateTime? //                            …until
  derivedFromId   String? // the memory this one was derived from (an inference's evidence, a lesson's experience)
  derivedFrom     Memory?          @relation("MemoryDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivations     Memory[]         @relation("MemoryDerivation")
  retractedAt     DateTime?
  retractedReason String?
  revisions       MemoryRevision[]

  @@index([principalId])
  @@index([type])
  @@index([status])
  @@index([principalId, subject])
  @@map("memories")
}

// Append-only history: the state a memory had BEFORE each approved change.
// Updates never silently overwrite the past. Ties back to the request and
// (when there was one) the approval that authorized the change.
model MemoryRevision {
  id                 String       @id @default(uuid())
  memoryId           String
  memory             Memory       @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  principalId        String
  principal          Principal    @relation(fields: [principalId], references: [id], onDelete: Cascade)
  changeType         String // UPDATE | CONFIRM | RETRACT
  previousContent    String
  previousConfidence Float
  previousStatus     MemoryStatus
  previousValidFrom  DateTime?
  previousValidUntil DateTime?
  previousExpiresAt  DateTime?
  changedAt          DateTime     @default(now())
  requestId          String?
  interfaceSource    String?
  approvalId         String?

  @@index([memoryId, changedAt])
  @@index([principalId])
  @@map("memory_revisions")
}

// ── Knowledge (Markdown files on disk; this table is metadata only) ───────

model KnowledgeDocument {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  path      String // relative path under knowledge/markdown/
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("knowledge_documents")
}

// ── Skills & Agents (registry, not credentials) ────────────────────────────

model Skill {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "system.tasks"
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions Permission[]

  @@map("skills")
}

model Agent {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "jarvis-core"
  name        String
  description String?
  createdAt   DateTime @default(now())

  permissions Permission[]
  approvals   ApprovalRequest[]
  auditLogs   AuditLog[]

  @@map("agents")
}

// ── Permission & Action Gateway ────────────────────────────────────────────

enum ActionCategory {
  READ
  WRITE
  EXECUTE
}

enum PermissionState {
  ALLOWED
  DENIED
  APPROVAL_REQUIRED
}

// One row = "this agent, using this skill, may take this action on this
// resource, under this permission state". Deliberately not copied from
// jarvis-1.0's access_grants: this is agent/skill/action scoped, not
// person-to-person delegation.
model Permission {
  id          String          @id @default(uuid())
  principalId String
  principal   Principal       @relation(fields: [principalId], references: [id], onDelete: Cascade)
  agentId     String
  agent       Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  resource    String // e.g. "gmail:angel@example.com", "calendar:primary"
  action      String // specific action key, e.g. "SEND_EMAIL", "READ", "DELETE_EVENT"
  category    ActionCategory
  state       PermissionState
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([principalId, agentId, skillId, resource, action])
  @@index([principalId])
  @@map("permissions")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CONSUMED
}

// One approval binds a principal to ONE exact action + parameters. The
// binding fields (everything except status/decision/execution columns) are
// immutable — enforced by a database trigger, not only by application code.
model ApprovalRequest {
  id              String           @id @default(uuid())
  principalId     String
  principal       Principal        @relation(fields: [principalId], references: [id], onDelete: Cascade)
  agentId         String
  agent           Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillKey        String
  resource        String
  action          String
  parameters      Json             @default("{}")
  // SHA-256 over the canonical serialization of principal + action + parameters.
  payloadHash     String
  status          ApprovalStatus   @default(PENDING)
  reason          String?
  // Interface and request that CREATED the proposal (stamped from the authenticated identity).
  interfaceSource String?
  requestId       String?
  requestedAt     DateTime         @default(now())
  expiresAt       DateTime
  decidedAt       DateTime?
  decidedVia      String? // interface that approved/denied
  consumedAt      DateTime?
  executionStatus ExecutionStatus?

  @@index([principalId, status])
  @@index([status, expiresAt])
  @@map("approval_requests")
}

enum ExecutionStatus {
  STARTED
  SUCCEEDED
  FAILED
}

// ── Audit log ────────────────────────────────────────────────────────────

enum AuditEventType {
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  ACTION_REQUESTED
  ACTION_APPROVED
  ACTION_REJECTED
  ACTION_EXECUTED
  ACTION_FAILED
  ACTION_DENIED
  APPROVAL_CREATED
  APPROVAL_APPROVED
  APPROVAL_DENIED
  APPROVAL_EXPIRED
  APPROVAL_CONSUMED
  ACTION_EXECUTION_STARTED
  ACTION_EXECUTION_SUCCEEDED
  ACTION_EXECUTION_FAILED
  REMINDER_DELIVERY_STARTED
  REMINDER_DELIVERED
  REMINDER_DELIVERY_FAILED
  REMINDER_DELIVERY_UNCONFIRMED
  TOKEN_CREATED
  TOKEN_REVOKED
  IDENTITY_LINKED
  IDENTITY_UNLINKED
  CONNECTION_CREATED
  CONNECTION_DISABLED
  CONNECTION_REMOVED
  CONNECTION_AUTHORIZED
  CONNECTION_FAILED
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
  PENDING
}

model AuditLog {
  id              String         @id @default(uuid())
  principalId     String
  principal       Principal      @relation(fields: [principalId], references: [id], onDelete: Cascade)
  agentId         String?
  agent           Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  eventType       AuditEventType
  resource        String?
  action          String?
  result          AuditResult
  source          String // e.g. "api", "cli", "system" — which SUBSYSTEM wrote the event
  // Which INTERFACE the request came from (GUIDEHUB, TELEGRAM, ...) and the
  // request it belonged to. Null for events with no interface request
  // behind them (seed scripts, tests, system jobs).
  interfaceSource String?
  requestId       String?
  metadata        Json           @default("{}") // never store secrets here
  createdAt       DateTime       @default(now())

  @@index([principalId])
  @@index([eventType])
  @@index([createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

// ── Integration / Connector layer ──────────────────────────────────────────
//
// A Connection is a principal-scoped record of an authenticated external
// account (e.g. "Angel's Google account"). It intentionally holds NO secret
// value — see connectors/credentials/index.ts's CredentialStore. `provider`
// is a free-form key (not an enum) so a new provider never needs a schema
// migration, the same way `tool_accounts.tool_key` worked in jarvis-1.0 —
// pattern reused, no jarvis-1.0 code or table imported.

enum ConnectionStatus {
  PENDING // created, not yet authorized
  ACTIVE // authorized and usable
  DISABLED // explicitly turned off by the principal, still on record
  ERROR // last known operation failed (see ConnectionHealthStatus)
}

model Connection {
  id                String           @id @default(uuid())
  principalId       String
  principal         Principal        @relation(fields: [principalId], references: [id], onDelete: Cascade)
  provider          String // e.g. "google", "telegram" — free-form, not an enum
  externalAccountId String // the account identifier on the provider's side, e.g. an email
  displayName       String?
  status            ConnectionStatus @default(PENDING)
  // Points at a secret in CredentialStore — never the secret itself. Null
  // until a connection is actually authorized.
  credentialRef     String?
  metadata          Json             @default("{}") // never store secrets here
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([principalId, provider, externalAccountId])
  @@index([principalId])
  @@map("connections")
}

// A short-lived, single-use, principal-bound OAuth state token. Binds an
// authorization callback back to the principal that initiated it, so a
// caller cannot supply an arbitrary ?code=...&state=... and attach it to
// any principal (see docs/SECURITY.md "OAuth state security"). Built here
// specifically because the API has no real session/auth layer yet — this
// is the explicit, documented substitute for "the session that started the
// flow", not a pretense of production authentication.
model OAuthState {
  id          String    @id @default(uuid())
  principalId String
  principal   Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  provider    String
  state       String    @unique // opaque random token, placed in the OAuth `state` param
  redirectUri String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime? // set the instant the callback consumes it — never reusable after

  @@index([principalId])
  @@index([expiresAt])
  @@map("oauth_states")
}

// Backing store for EncryptedCredentialStore (connectors/credentials/
// encrypted.ts). Holds ONLY ciphertext — see that file for the encryption
// boundary and key-source documentation. `ref` (not principalId) is the
// lookup key, matching the CredentialStore interface's shape; callers
// choose refs that already encode the principal (e.g.
// "google:<connectionId>") so a leaked ref can't be reused across
// principals by guesswork alone.
model CredentialSecret {
  id         String   @id @default(uuid())
  ref        String   @unique
  ciphertext String
  iv         String
  authTag    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("credential_secrets")
}

// ── Identity & interfaces ──────────────────────────────────────────────────
//
// Every interface (GuideHub, Telegram, voice, API clients...) authenticates
// to a principal through one of these two credential kinds. Neither ever
// holds a secret in plaintext, and neither lets a client choose its own
// principalId — the credential IS the binding.

// A bearer token for API clients (a web cockpit, a mobile app, a voice
// fulfillment server). Only the SHA-256 hash is stored; the plaintext is
// shown once, at creation. Tokens are 256-bit random, so a fast hash is
// sufficient (there is nothing to brute-force). The interface is fixed by
// the token, not claimed by the client.
model ApiToken {
  id              String    @id @default(uuid())
  principalId     String
  principal       Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  interfaceSource String
  label           String
  tokenHash       String    @unique
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@index([principalId])
  @@map("api_tokens")
}

// Maps an identity that exists on someone else's platform (a Telegram user
// id, a voice device id) to a principal. (interface, externalId) is unique:
// one external account can belong to exactly one principal, and re-linking
// it elsewhere requires an explicit unlink first.
model ExternalIdentity {
  id              String    @id @default(uuid())
  principalId     String
  principal       Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  interfaceSource String
  externalId      String
  label           String?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@unique([interfaceSource, externalId])
  @@index([principalId])
  @@map("external_identities")
}

// Polling position for an interface (e.g. the last Telegram update id
// handled), so a restart doesn't replay old messages.
model InterfaceCursor {
  id              String   @id @default(uuid())
  interfaceSource String
  name            String
  value           BigInt
  updatedAt       DateTime @updatedAt

  @@unique([interfaceSource, name])
  @@map("interface_cursors")
}

// ── Activity (user-facing life history) ───────────────────────────────────
//
// NOT the audit log. Audit answers "what did the system do, and was it
// allowed?" (security trace: denials, failures, permission changes).
// Activity answers "what happened in my life?" (meaningful things Angel
// did or that were recorded). An action can produce both; a denied action
// produces only audit. Activity rows hold references (refType/refId) and a
// short generic summary — never a copy of memory or task content.

enum ActivityType {
  TASK_COMPLETED
  QUEST_COMPLETED
  LEARNING_SESSION
  KNOWLEDGE_ADDED
  HABIT_COMPLETED
  GOAL_PROGRESS
  ACHIEVEMENT
  MEETING
  DECISION
  MEMORY_CREATED
  REMINDER_DELIVERED
}

model Activity {
  id              String       @id @default(uuid())
  principalId     String
  principal       Principal    @relation(fields: [principalId], references: [id], onDelete: Cascade)
  type            ActivityType
  occurredAt      DateTime     @default(now())
  summary         String
  area            String? // life area slug, e.g. "learning", "fitness" — free-form, validated in code
  refType         String? // what this points at, e.g. "memory", "task"
  refId           String?
  interfaceSource String? // which interface recorded it
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())

  @@index([principalId, occurredAt(sort: Desc)])
  @@index([principalId, type])
  @@map("activities")
}
