// Angel OS — Prisma schema
// PostgreSQL is the single structured source of truth (see docs/ARCHITECTURE.md).
// Every personal object is scoped to `principalId`. There is exactly one
// Principal row today (Angel); the FK shape stays ready for multi-user later
// without any multi-user logic being implemented now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Principal ────────────────────────────────────────────────────────────

model Principal {
  id        String   @id @default(uuid())
  name      String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  people             Person[]
  projects           Project[]
  tasks              Task[]
  reminders          Reminder[]
  goals              Goal[]
  decisions          Decision[]
  memories           Memory[]
  permissions        Permission[]
  approvals          ApprovalRequest[]
  auditLogs          AuditLog[]
  connections        Connection[]
  oauthStates        OAuthState[]
  apiTokens          ApiToken[]
  externalIdentities ExternalIdentity[]
  activities         Activity[]
  memoryRevisions    MemoryRevision[]
  knowledgeSources   KnowledgeSource[]
  knowledgeItems     KnowledgeItem[]
  knowledgeRelations KnowledgeRelation[]
  visions            Vision[]
  quests             Quest[]
  results            Result[]
  aspirations        Aspiration[]
  reviews            Review[]

  @@map("principals")
}

// ── Structured state ────────────────────────────────────────────────────

// People Angel knows — NOT employees, NOT agency staff.
model Person {
  id           String    @id @default(uuid())
  principalId  String
  principal    Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  name         String
  relationship String? // e.g. "friend", "sister", "colleague at X" — free text, not a role/org concept
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tasks    Task[]
  projects ProjectPerson[]

  @@index([principalId])
  @@map("people")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Project {
  id          String        @id @default(uuid())
  principalId String
  principal   Principal     @relation(fields: [principalId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  goalId      String?
  goal        Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  targetDate  DateTime?
  completedAt DateTime?

  tasks     Task[]
  decisions Decision[]
  quests    Quest[]
  people    ProjectPerson[]
  knowledge ProjectKnowledge[]

  @@index([principalId])
  @@map("projects")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id              String     @id @default(uuid())
  principalId     String
  principal       Principal  @relation(fields: [principalId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  relatedPersonId String?
  relatedPerson   Person?    @relation(fields: [relatedPersonId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  dueAt           DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  questId         String?
  quest           Quest?     @relation(fields: [questId], references: [id], onDelete: SetNull)
  completedAt     DateTime? // set when DONE

  reminders Reminder[]

  @@index([principalId])
  @@index([projectId])
  @@index([questId])
  @@map("tasks")
}

enum ReminderStatus {
  PENDING // waiting for remindAt (or for a retry after a definite delivery failure)
  CLAIMED // a worker holds the lease and is delivering it
  SENT // delivered — the channel confirmed acceptance
  FAILED // gave up: non-retryable failure or attempts exhausted
  UNCONFIRMED // a send was attempted but its outcome is unknown; never re-sent automatically
  DISMISSED
}

model Reminder {
  id          String         @id @default(uuid())
  principalId String
  principal   Principal      @relation(fields: [principalId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  message     String
  remindAt    DateTime
  status      ReminderStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Delivery lifecycle (see docs/architecture/reminders-and-delivery.md).
  claimedAt         DateTime?
  leaseUntil        DateTime? // a CLAIMED row whose lease has passed is recoverable
  deliveryAttempts  Int       @default(0) // also the fence token for the current claim
  lastAttemptAt     DateTime?
  sendStartedAt     DateTime? // set immediately before the channel call: after this, a crash means "unknown"
  nextAttemptAt     DateTime? // backoff after a retryable failure
  deliveredAt       DateTime?
  deliveryChannel   String?
  lastDeliveryError String? // a short safe code, never provider text

  @@index([principalId])
  @@index([remindAt])
  @@index([status, remindAt])
  @@map("reminders")
}

// ── Life OS (Build #12) ────────────────────────────────────────────────────
//   VISION → GOAL → PROJECT → QUEST → ACTION (task)
// Every link is between rows of the SAME principal: enforced by database
// triggers (life_owner_guard), not just by the application. Terminal
// statuses (achieved, abandoned, completed, cancelled, archived) never reopen.

enum VisionStatus {
  ACTIVE
  ARCHIVED
}

model Vision {
  id          String       @id @default(uuid())
  principalId String
  principal   Principal    @relation(fields: [principalId], references: [id], onDelete: Cascade)
  title       String
  statement   String // the long-term direction, in Angel's own words
  status      VisionStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  goals Goal[]

  @@index([principalId])
  @@map("visions")
}

enum QuestStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ABANDONED
}

// A bounded challenge inside a project with EXPLICIT completion criteria.
// Completing a quest is a statement by Angel that the criteria were met — the
// system never marks one complete on its own.
model Quest {
  id          String      @id @default(uuid())
  principalId String
  principal   Principal   @relation(fields: [principalId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  objective   String
  criteria    String // what "done" means
  status      QuestStatus @default(PLANNED)
  dueAt       DateTime?
  startedAt   DateTime?
  closedAt    DateTime?
  closedNote  String? // completion note or abandonment reason
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tasks Task[]

  @@index([principalId, status])
  @@index([projectId])
  @@map("quests")
}

model ProjectPerson {
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  principalId String
  role        String?
  createdAt   DateTime @default(now())

  @@id([projectId, personId])
  @@index([principalId])
  @@map("project_people")
}

model ProjectKnowledge {
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemId      String
  item        KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  principalId String
  note        String?
  createdAt   DateTime      @default(now())

  @@id([projectId, itemId])
  @@index([principalId])
  @@map("project_knowledge")
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

enum GoalHorizon {
  SHORT
  MEDIUM
  LONG
}

model Goal {
  id          String      @id @default(uuid())
  principalId String
  principal   Principal   @relation(fields: [principalId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      GoalStatus  @default(ACTIVE)
  horizon     GoalHorizon @default(MEDIUM)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  visionId    String?
  vision      Vision?     @relation(fields: [visionId], references: [id], onDelete: SetNull)
  targetDate  DateTime?
  closedAt    DateTime? // set when ACHIEVED or ABANDONED
  closedNote  String? // achievement note or abandonment reason

  projects Project[]

  @@index([principalId])
  @@index([visionId])
  @@map("goals")
}

// A Decision is CURRENT STATE that becomes HISTORY once superseded — it is
// never rewritten, only ever superseded by a new row referencing it, so
// "what did I decide about X" stays answerable from a stable log.
model Decision {
  id           String    @id @default(uuid())
  principalId  String
  principal    Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String
  context      String?
  decision     String
  supersedesId String?   @unique
  supersedes   Decision? @relation("DecisionHistory", fields: [supersedesId], references: [id])
  supersededBy Decision? @relation("DecisionHistory")
  decidedAt    DateTime  @default(now())
  question     String? // what was being decided
  reasoning    String? // why this option
  expected     String? // what the owner expects to happen (a prediction, judged later against `outcome`)
  reviewAt     DateTime? // when the owner wants to look back
  // The look-back. Set ONCE (with reviewedAt); everything above is immutable history.
  outcome      String?
  lesson       String?
  reviewedAt   DateTime?

  options  DecisionOption[]
  evidence DecisionEvidence[]

  @@index([principalId])
  @@map("decisions")
}

// ── Memory (distinct from structured state and knowledge) ─────────────────

enum MemoryType {
  FACT
  PREFERENCE
  PRINCIPLE
  DECISION
  GOAL
  HABIT
  EXPERIENCE
  PERSON
  PROJECT
  INFERENCE
  LESSON // what an experience taught (may reference the experience via derivedFromId)
  RELATIONSHIP // something about Angel's relationship with a person/group (subject names them)
  CONTEXT // situational personal context ("traveling until March"); pair with validUntil
}

// Where a memory came from. Invariants (enforced in the database, not just code):
//   type INFERENCE  <=>  provenance INFERRED   (a belief is never laundered into a fact by relabeling)
//   type EXPERIENCE  =>  provenance EXPERIENCED
enum ProvenanceKind {
  STATED // Angel said or entered it
  OBSERVED // the system observed it (not inferred beyond the observation)
  EXPERIENCED // personally experienced / tested
  INFERRED // a derived belief, hypothesis or conclusion
}

enum MemoryStatus {
  ACTIVE // confirmed / standing
  UNCONFIRMED // inferred, not yet promoted to a standing fact
  EXPIRED
  RETRACTED
}

model Memory {
  id              String       @id @default(uuid())
  principalId     String
  principal       Principal    @relation(fields: [principalId], references: [id], onDelete: Cascade)
  type            MemoryType
  content         String
  source          String // e.g. "conversation", "manual", "inference:task-pattern"
  confidence      Float        @default(1.0) // 0..1, lower for INFERENCE
  status          MemoryStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastConfirmedAt DateTime?
  // System lifetime: the memory stops being retrieved after this instant.
  expiresAt       DateTime?

  // ── Memory OS (Build #9) ──
  provenance      ProvenanceKind   @default(STATED)
  sourceRef       String? // free reference to the origin (a message id, a URL, a memory id) — provenance detail, never authority
  subject         String? // who/what it is about ("Ana", "my sister", "Bogotá trip")
  occurredAt      DateTime? // when the experience/event happened (world time)
  validFrom       DateTime? // world-time validity window: true from…
  validUntil      DateTime? //                            …until
  derivedFromId   String? // the memory this one was derived from (an inference's evidence, a lesson's experience)
  derivedFrom     Memory?          @relation("MemoryDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivations     Memory[]         @relation("MemoryDerivation")
  retractedAt     DateTime?
  retractedReason String?
  revisions       MemoryRevision[]

  @@index([principalId])
  @@index([type])
  @@index([status])
  @@index([principalId, subject])
  @@map("memories")
}

// Append-only history: the state a memory had BEFORE each approved change.
// Updates never silently overwrite the past. Ties back to the request and
// (when there was one) the approval that authorized the change.
model MemoryRevision {
  id                 String       @id @default(uuid())
  memoryId           String
  memory             Memory       @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  principalId        String
  principal          Principal    @relation(fields: [principalId], references: [id], onDelete: Cascade)
  changeType         String // UPDATE | CONFIRM | RETRACT
  previousContent    String
  previousConfidence Float
  previousStatus     MemoryStatus
  previousValidFrom  DateTime?
  previousValidUntil DateTime?
  previousExpiresAt  DateTime?
  changedAt          DateTime     @default(now())
  requestId          String?
  interfaceSource    String?
  approvalId         String?

  @@index([memoryId, changedAt])
  @@index([principalId])
  @@map("memory_revisions")
}

// ── Knowledge (Markdown files on disk; this table is metadata only) ───────

model KnowledgeDocument {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  path      String // relative path under knowledge/markdown/
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("knowledge_documents")
}

// ── Knowledge OS (Build #10): information about the WORLD, owned per principal ──
//
// Separate from Memory (information about Angel): different tables, no
// conversion path in either direction. Everything here is scoped by
// principalId; an item's kind is immutable (a HYPOTHESIS never becomes a
// FACT by editing); relations can only join items of the SAME principal
// (enforced by a database trigger).

enum KnowledgeKind {
  FACT
  CONCEPT
  PRINCIPLE
  METHOD
  PERSON
  EVENT
  DATE
  QUESTION
  HYPOTHESIS
  INSIGHT
  CONTRADICTION
  EXPERIENCE // a documented experience / case study in the world; Angel's OWN experiences are Memory
}

enum KnowledgeRelationKind {
  RELATED_TO
  EXPLAINS
  SUPPORTS
  CONTRADICTS
  CAUSES
  EXAMPLE_OF
  APPLIES_TO
  INSPIRED_BY
  DERIVED_FROM
  PART_OF
  SIMILAR_TO
}

enum KnowledgeStatus {
  ACTIVE
  RETRACTED
}

enum KnowledgeOrigin {
  INGESTED // produced by the ingestion pipeline from a source
  MANUAL // entered by hand; carries no source
}

// SOURCE: where knowledge came from (a note, a markdown file, a book, a URL reference).
// The reference is descriptive only — nothing is ever fetched from it.
model KnowledgeSource {
  id          String          @id @default(uuid())
  principalId String
  principal   Principal       @relation(fields: [principalId], references: [id], onDelete: Cascade)
  title       String
  kind        String // note | markdown | text | book | article | url ...
  uri         String?
  contentHash String // SHA-256 of the ingested content: the same content is never ingested twice
  ingestedAt  DateTime        @default(now())
  items       KnowledgeItem[]

  @@unique([principalId, contentHash])
  @@index([principalId])
  @@map("knowledge_sources")
}

model KnowledgeItem {
  id               String              @id @default(uuid())
  principalId      String
  principal        Principal           @relation(fields: [principalId], references: [id], onDelete: Cascade)
  kind             KnowledgeKind
  title            String
  body             String
  origin           KnowledgeOrigin
  sourceId         String?
  source           KnowledgeSource?    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  confidence       Float? // meaningful for HYPOTHESIS / INSIGHT / FACT claims; null = not assessed
  eventAt          DateTime? // EVENT / DATE items
  status           KnowledgeStatus     @default(ACTIVE)
  retractedAt      DateTime?
  retractedReason  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  from             KnowledgeRelation[] @relation("RelationFrom")
  to               KnowledgeRelation[] @relation("RelationTo")
  ProjectKnowledge ProjectKnowledge[]

  @@index([principalId, kind])
  @@index([principalId, status])
  @@index([sourceId])
  @@map("knowledge_items")
}

model KnowledgeRelation {
  id          String                @id @default(uuid())
  principalId String
  principal   Principal             @relation(fields: [principalId], references: [id], onDelete: Cascade)
  fromId      String
  from        KnowledgeItem         @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          KnowledgeItem         @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)
  kind        KnowledgeRelationKind
  note        String?
  createdAt   DateTime              @default(now())

  @@unique([fromId, toId, kind])
  @@index([principalId])
  @@index([toId])
  @@map("knowledge_relations")
}

// ── Skills & Agents (registry, not credentials) ────────────────────────────

model Skill {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "system.tasks"
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions Permission[]

  @@map("skills")
}

model Agent {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "jarvis-core"
  name        String
  description String?
  createdAt   DateTime @default(now())

  permissions Permission[]
  approvals   ApprovalRequest[]
  auditLogs   AuditLog[]

  @@map("agents")
}

// ── Permission & Action Gateway ────────────────────────────────────────────

enum ActionCategory {
  READ
  WRITE
  EXECUTE
}

enum PermissionState {
  ALLOWED
  DENIED
  APPROVAL_REQUIRED
}

// One row = "this agent, using this skill, may take this action on this
// resource, under this permission state". Deliberately not copied from
// jarvis-1.0's access_grants: this is agent/skill/action scoped, not
// person-to-person delegation.
model Permission {
  id          String          @id @default(uuid())
  principalId String
  principal   Principal       @relation(fields: [principalId], references: [id], onDelete: Cascade)
  agentId     String
  agent       Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  resource    String // e.g. "gmail:angel@example.com", "calendar:primary"
  action      String // specific action key, e.g. "SEND_EMAIL", "READ", "DELETE_EVENT"
  category    ActionCategory
  state       PermissionState
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([principalId, agentId, skillId, resource, action])
  @@index([principalId])
  @@map("permissions")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CONSUMED
}

// One approval binds a principal to ONE exact action + parameters. The
// binding fields (everything except status/decision/execution columns) are
// immutable — enforced by a database trigger, not only by application code.
model ApprovalRequest {
  id              String           @id @default(uuid())
  principalId     String
  principal       Principal        @relation(fields: [principalId], references: [id], onDelete: Cascade)
  agentId         String
  agent           Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skillKey        String
  resource        String
  action          String
  parameters      Json             @default("{}")
  // SHA-256 over the canonical serialization of principal + action + parameters.
  payloadHash     String
  status          ApprovalStatus   @default(PENDING)
  reason          String?
  // Interface and request that CREATED the proposal (stamped from the authenticated identity).
  interfaceSource String?
  requestId       String?
  requestedAt     DateTime         @default(now())
  expiresAt       DateTime
  decidedAt       DateTime?
  decidedVia      String? // interface that approved/denied
  consumedAt      DateTime?
  executionStatus ExecutionStatus?

  @@index([principalId, status])
  @@index([status, expiresAt])
  @@map("approval_requests")
}

enum ExecutionStatus {
  STARTED
  SUCCEEDED
  FAILED
}

// ── Audit log ────────────────────────────────────────────────────────────

enum AuditEventType {
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  ACTION_REQUESTED
  ACTION_APPROVED
  ACTION_REJECTED
  ACTION_EXECUTED
  ACTION_FAILED
  ACTION_DENIED
  APPROVAL_CREATED
  APPROVAL_APPROVED
  APPROVAL_DENIED
  APPROVAL_EXPIRED
  APPROVAL_CONSUMED
  ACTION_EXECUTION_STARTED
  ACTION_EXECUTION_SUCCEEDED
  ACTION_EXECUTION_FAILED
  REMINDER_DELIVERY_STARTED
  REMINDER_DELIVERED
  REMINDER_DELIVERY_FAILED
  REMINDER_DELIVERY_UNCONFIRMED
  TOKEN_CREATED
  TOKEN_REVOKED
  IDENTITY_LINKED
  IDENTITY_UNLINKED
  CONNECTION_CREATED
  CONNECTION_DISABLED
  CONNECTION_REMOVED
  CONNECTION_AUTHORIZED
  CONNECTION_FAILED
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
  PENDING
}

model AuditLog {
  id              String         @id @default(uuid())
  principalId     String
  principal       Principal      @relation(fields: [principalId], references: [id], onDelete: Cascade)
  agentId         String?
  agent           Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  eventType       AuditEventType
  resource        String?
  action          String?
  result          AuditResult
  source          String // e.g. "api", "cli", "system" — which SUBSYSTEM wrote the event
  // Which INTERFACE the request came from (GUIDEHUB, TELEGRAM, ...) and the
  // request it belonged to. Null for events with no interface request
  // behind them (seed scripts, tests, system jobs).
  interfaceSource String?
  requestId       String?
  metadata        Json           @default("{}") // never store secrets here
  createdAt       DateTime       @default(now())

  @@index([principalId])
  @@index([eventType])
  @@index([createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

// ── Integration / Connector layer ──────────────────────────────────────────
//
// A Connection is a principal-scoped record of an authenticated external
// account (e.g. "Angel's Google account"). It intentionally holds NO secret
// value — see connectors/credentials/index.ts's CredentialStore. `provider`
// is a free-form key (not an enum) so a new provider never needs a schema
// migration, the same way `tool_accounts.tool_key` worked in jarvis-1.0 —
// pattern reused, no jarvis-1.0 code or table imported.

enum ConnectionStatus {
  PENDING // created, not yet authorized
  ACTIVE // authorized and usable
  DISABLED // explicitly turned off by the principal, still on record
  ERROR // last known operation failed (see ConnectionHealthStatus)
}

model Connection {
  id                String           @id @default(uuid())
  principalId       String
  principal         Principal        @relation(fields: [principalId], references: [id], onDelete: Cascade)
  provider          String // e.g. "google", "telegram" — free-form, not an enum
  externalAccountId String // the account identifier on the provider's side, e.g. an email
  displayName       String?
  status            ConnectionStatus @default(PENDING)
  // Points at a secret in CredentialStore — never the secret itself. Null
  // until a connection is actually authorized.
  credentialRef     String?
  metadata          Json             @default("{}") // never store secrets here
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([principalId, provider, externalAccountId])
  @@index([principalId])
  @@map("connections")
}

// A short-lived, single-use, principal-bound OAuth state token. Binds an
// authorization callback back to the principal that initiated it, so a
// caller cannot supply an arbitrary ?code=...&state=... and attach it to
// any principal (see docs/SECURITY.md "OAuth state security"). Built here
// specifically because the API has no real session/auth layer yet — this
// is the explicit, documented substitute for "the session that started the
// flow", not a pretense of production authentication.
model OAuthState {
  id          String    @id @default(uuid())
  principalId String
  principal   Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  provider    String
  state       String    @unique // opaque random token, placed in the OAuth `state` param
  redirectUri String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime? // set the instant the callback consumes it — never reusable after

  @@index([principalId])
  @@index([expiresAt])
  @@map("oauth_states")
}

// Backing store for EncryptedCredentialStore (connectors/credentials/
// encrypted.ts). Holds ONLY ciphertext — see that file for the encryption
// boundary and key-source documentation. `ref` (not principalId) is the
// lookup key, matching the CredentialStore interface's shape; callers
// choose refs that already encode the principal (e.g.
// "google:<connectionId>") so a leaked ref can't be reused across
// principals by guesswork alone.
model CredentialSecret {
  id         String   @id @default(uuid())
  ref        String   @unique
  ciphertext String
  iv         String
  authTag    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("credential_secrets")
}

// ── Identity & interfaces ──────────────────────────────────────────────────
//
// Every interface (GuideHub, Telegram, voice, API clients...) authenticates
// to a principal through one of these two credential kinds. Neither ever
// holds a secret in plaintext, and neither lets a client choose its own
// principalId — the credential IS the binding.

// A bearer token for API clients (a web cockpit, a mobile app, a voice
// fulfillment server). Only the SHA-256 hash is stored; the plaintext is
// shown once, at creation. Tokens are 256-bit random, so a fast hash is
// sufficient (there is nothing to brute-force). The interface is fixed by
// the token, not claimed by the client.
model ApiToken {
  id              String    @id @default(uuid())
  principalId     String
  principal       Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  interfaceSource String
  label           String
  tokenHash       String    @unique
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@index([principalId])
  @@map("api_tokens")
}

// Maps an identity that exists on someone else's platform (a Telegram user
// id, a voice device id) to a principal. (interface, externalId) is unique:
// one external account can belong to exactly one principal, and re-linking
// it elsewhere requires an explicit unlink first.
model ExternalIdentity {
  id              String    @id @default(uuid())
  principalId     String
  principal       Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  interfaceSource String
  externalId      String
  label           String?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@unique([interfaceSource, externalId])
  @@index([principalId])
  @@map("external_identities")
}

// Polling position for an interface (e.g. the last Telegram update id
// handled), so a restart doesn't replay old messages.
model InterfaceCursor {
  id              String   @id @default(uuid())
  interfaceSource String
  name            String
  value           BigInt
  updatedAt       DateTime @updatedAt

  @@unique([interfaceSource, name])
  @@map("interface_cursors")
}

// ── Activity (user-facing life history) ───────────────────────────────────
//
// NOT the audit log. Audit answers "what did the system do, and was it
// allowed?" (security trace: denials, failures, permission changes).
// Activity answers "what happened in my life?" (meaningful things Angel
// did or that were recorded). An action can produce both; a denied action
// produces only audit. Activity rows hold references (refType/refId) and a
// short generic summary — never a copy of memory or task content.

enum ActivityType {
  TASK_COMPLETED
  QUEST_COMPLETED
  LEARNING_SESSION
  KNOWLEDGE_ADDED
  HABIT_COMPLETED
  GOAL_PROGRESS
  ACHIEVEMENT
  MEETING
  DECISION
  MEMORY_CREATED
  REMINDER_DELIVERED
}

model Activity {
  id              String       @id @default(uuid())
  principalId     String
  principal       Principal    @relation(fields: [principalId], references: [id], onDelete: Cascade)
  type            ActivityType
  occurredAt      DateTime     @default(now())
  summary         String
  area            String? // life area slug, e.g. "learning", "fitness" — free-form, validated in code
  refType         String? // what this points at, e.g. "memory", "task"
  refId           String?
  interfaceSource String? // which interface recorded it
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())

  @@index([principalId, occurredAt(sort: Desc)])
  @@index([principalId, type])
  @@map("activities")
}

// ── Decision records, results, reviews (BUILD #13) ────────────────────────

model DecisionOption {
  id          String   @id @default(uuid())
  principalId String
  decisionId  String
  decision    Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  label       String
  pros        String?
  cons        String?
  chosen      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([decisionId])
  @@index([principalId])
  @@map("decision_options")
}

enum EvidenceKind {
  MEMORY
  KNOWLEDGE
  TASK
  NOTE
}

// What the decision was based on. A reference (checked to be the owner's) plus
// a snapshot label, so the record stays readable if the referenced row is later
// deleted. Kind is never upgraded: a MEMORY reference does not turn an
// INFERENCE into a fact.
model DecisionEvidence {
  id          String       @id @default(uuid())
  principalId String
  decisionId  String
  decision    Decision     @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  kind        EvidenceKind
  refId       String?
  label       String
  createdAt   DateTime     @default(now())

  @@index([decisionId])
  @@index([principalId])
  @@map("decision_evidence")
}

enum ResultSubject {
  GOAL
  PROJECT
  QUEST
  DECISION
}

// An owner-recorded outcome, append-only. `value`/`unit` are an optional measurement the
// owner supplies; nothing is computed or inferred here.
model Result {
  id          String        @id @default(uuid())
  principalId String
  principal   Principal     @relation(fields: [principalId], references: [id], onDelete: Cascade)
  subjectKind ResultSubject
  subjectId   String
  statement   String
  value       Float?
  unit        String?
  recordedAt  DateTime      @default(now())

  @@index([principalId, recordedAt])
  @@index([subjectKind, subjectId])
  @@map("results")
}

// A periodic look-back. `facts` is a snapshot of plain counts taken from the database at
// creation (never a judgement); `summary`/`wins`/`lessons`/`nextSteps` are the owner's words.
// Immutable once created.
model Review {
  id          String    @id @default(uuid())
  principalId String
  principal   Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  summary     String
  wins        String?
  lessons     String?
  nextSteps   String?
  facts       Json
  createdAt   DateTime  @default(now())

  @@index([principalId, periodEnd])
  @@map("reviews")
}

// ── Future Self (BUILD #14) ───────────────────────────────────────────────
// CURRENT → GAP → DESIRED → NEXT, all in the owner's words. Progress is never a stored score or XP:
// it is computed on read from owner-set metric baseline/target and recorded readings, and "no
// readings" reads as "no evidence yet". Reaching 100% never closes an aspiration; the owner does.

enum AspirationStatus {
  ACTIVE
  ACHIEVED
  RELEASED // deliberately let go
}

model Aspiration {
  id          String           @id @default(uuid())
  principalId String
  principal   Principal        @relation(fields: [principalId], references: [id], onDelete: Cascade)
  title       String
  area        String? // free tag, e.g. "health"
  current     String // where I am, in my words
  gap         String? // what is missing, in my words
  desired     String // who/where I want to be
  goalId      String?
  nextTaskId  String? // the concrete NEXT step
  nextQuestId String?
  status      AspirationStatus @default(ACTIVE)
  closedAt    DateTime?
  closedNote  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  metrics Metric[]

  @@index([principalId, status])
  @@map("aspirations")
}

// Set once. Baseline and target are never edited afterwards, so progress cannot be gamed by moving the goalposts.
model Metric {
  id           String     @id @default(uuid())
  principalId  String
  aspirationId String
  aspiration   Aspiration @relation(fields: [aspirationId], references: [id], onDelete: Cascade)
  name         String
  unit         String
  baseline     Float
  target       Float
  createdAt    DateTime   @default(now())

  readings MetricReading[]

  @@index([aspirationId])
  @@index([principalId])
  @@map("metrics")
}

// Append-only. Optionally backed by a Result (the evidence the reading came from).
model MetricReading {
  id          String   @id @default(uuid())
  principalId String
  metricId    String
  metric      Metric   @relation(fields: [metricId], references: [id], onDelete: Cascade)
  value       Float
  observedAt  DateTime
  resultId    String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([metricId, observedAt])
  @@index([principalId])
  @@map("metric_readings")
}
