{
  "name": "angel-os",
  "version": "0.1.0",
  "description": "Angel OS — personal AI operating system / second brain / chief-of-staff assistant. Separate from BlackOS.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch api/server.ts",
    "start": "node dist/api/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx db/seed/seed.ts",
    "identity": "tsx scripts/identity.ts",
    "telegram": "tsx scripts/telegram.ts",
    "worker": "tsx scripts/worker.ts",
    "ingest-markdown": "tsx scripts/ingest-markdown.ts",
    "guidehub": "tsx guidehub/server.ts",
    "guidehub:password": "tsx scripts/guidehub-password.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@prisma/client": "^5.20.0",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "prisma": {
    "schema": "db/schema.prisma"
  }
}
