# Angel OS — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL — the single structured source of truth (see docs/ARCHITECTURE.md)
DATABASE_URL="postgresql://angel:angel@localhost:5432/angel_os?schema=public"

# API server
PORT=3000

# LLM provider — used by Jarvis Core for intent parsing beyond v0.1's
# deterministic parser. Not required to run v0.1.
LLM_PROVIDER="anthropic"
LLM_API_KEY=""

# Memory provider selector: "local" (default, Postgres-backed, no external
# service) or "mem0" (requires MEM0_API_KEY). See docs/MEMORY.md.
MEMORY_PROVIDER="local"
MEM0_API_KEY=""

# Credential store selector: "encrypted" (default — AES-256-GCM, self-hosted,
# NOT a production secrets manager) or "env" (read-only, dev only). See
# docs/SECURITY.md "Credential handling (Connector Layer)".
CREDENTIAL_STORE="encrypted"
# Required when CREDENTIAL_STORE=encrypted: 32 bytes as 64 hex characters.
# Generate with: openssl rand -hex 32
ANGEL_OS_CREDENTIAL_ENCRYPTION_KEY=""

# Google OAuth (Calendar, read-only). Create credentials at
# https://console.cloud.google.com/apis/credentials — an OAuth 2.0 Client ID
# of type "Web application", with GOOGLE_OAUTH_REDIRECT_URI added as an
# authorized redirect URI. Never commit these values.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/google/calendar/callback"
