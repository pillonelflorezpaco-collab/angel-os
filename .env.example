# Angel OS — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL — the single structured source of truth (see docs/ARCHITECTURE.md)
DATABASE_URL="postgresql://angel:angel@localhost:5432/angel_os?schema=public"

# API server
PORT=3000

# LLM provider — used by Jarvis Core for intent parsing beyond v0.1's
# deterministic parser. Not required to run v0.1.
LLM_PROVIDER="anthropic"
LLM_API_KEY=""

# Jarvis capture interpreter (turns a sentence into a DRAFT you confirm; nothing is saved without confirmation).
# Off unless ANGEL_OS_CAPTURE_PROVIDER=anthropic AND ANTHROPIC_API_KEY is set. The key is read from the environment only.
# ANGEL_OS_CAPTURE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANGEL_OS_CAPTURE_MODEL=claude-opus-5-5          # e.g. claude-haiku-4-5 for a cheaper model
# ANGEL_OS_CAPTURE_MAX_CALLS_PER_DAY=200          # hard stop per process per UTC day

# Memory provider selector: "local" (default, Postgres-backed, no external
# service) or "mem0" (requires MEM0_API_KEY). See docs/MEMORY.md.
MEMORY_PROVIDER="local"
MEM0_API_KEY=""

# Credential store selector: "encrypted" (default — AES-256-GCM, self-hosted,
# NOT a production secrets manager) or "env" (read-only, dev only). See
# docs/SECURITY.md "Credential handling (Connector Layer)".
CREDENTIAL_STORE="encrypted"
# Required when CREDENTIAL_STORE=encrypted: 32 bytes as 64 hex characters.
# Generate with: openssl rand -hex 32
ANGEL_OS_CREDENTIAL_ENCRYPTION_KEY=""

# Google OAuth (Calendar, read-only). Create credentials at
# https://console.cloud.google.com/apis/credentials — an OAuth 2.0 Client ID
# of type "Web application", with GOOGLE_OAUTH_REDIRECT_URI added as an
# authorized redirect URI. Never commit these values.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/google/calendar/callback"

# Telegram interface (npm run telegram). Create a bot with @BotFather.
# Only private chats from accounts linked with `npm run identity -- link` are answered.
TELEGRAM_BOT_TOKEN=""

# Browser clients (e.g. a web cockpit): comma-separated EXACT origins allowed to
# call the API. Empty = CORS off. "*" is never honoured.
ANGEL_OS_CORS_ORIGINS=""

# Reminder worker (npm run worker): the ONE principal background work acts for.
ANGEL_OS_SYSTEM_PRINCIPAL_ID=00000000-0000-0000-0000-000000000001

# GuideHub cockpit (docs/guidehub/README.md) — set these only on the machine that runs `npm run guidehub`
# GUIDEHUB_API_TOKEN=aos_...            # a GUIDEHUB token from `npm run identity -- create-token`; never sent to the browser
# GUIDEHUB_PASSWORD_HASH=scrypt$...     # from `npm run guidehub:password`
# GUIDEHUB_API_URL=http://localhost:3000
# GUIDEHUB_PUBLIC_ORIGIN=https://cockpit.example.com
# GUIDEHUB_INSECURE_COOKIES=1           # plain-http localhost development ONLY
