{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["core", "memory", "knowledge", "context", "skills", "gateway", "connectors", "identity", "interfaces", "application", "activity", "reminders", "db", "api", "life", "future", "learning", "orchestration", "guidehub", "scripts", "tests"],
  "exclude": ["node_modules", "dist"]
}
